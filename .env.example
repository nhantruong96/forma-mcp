# ==== APS app (bắt buộc) ====
# Lấy từ https://aps.autodesk.com > My applications > <app của bạn>
APS_CLIENT_ID=

# Client Secret: CHỈ điền nếu app là loại "Traditional Web App" (khuyến nghị).
# Nếu app là loại "Desktop, Mobile, Single-Page App" thì ĐỂ TRỐNG (PKCE public client).
APS_CLIENT_SECRET=

# ==== Callback URL cho đăng nhập 3-legged ====
# PHẢI trùng khớp 100% với Callback URL khai báo trong app trên APS
APS_CALLBACK_URL=http://localhost:8087/callback

# ==== Region mặc định của hub ACC: US | EMEA | AUS | CAN | DEU | GBR | IND | JPN ====
APS_REGION=US

# ==== Chế độ xác thực ====
# 3lo  = CHỈ 3-legged (mặc định): mọi thao tác dưới danh nghĩa tài khoản đăng nhập qua acc_login
# auto = ưu tiên 3-legged, dự phòng 2-legged | 2lo = chỉ 2-legged
# (2lo/auto yêu cầu thêm: có APS_CLIENT_SECRET + app được thêm vào Custom Integrations của hub ACC)
ACC_AUTH_MODE=3lo

# ==== (Tuỳ chọn) Quy ước đặt tên mặc định: iso19650-uk | tên file config trong ~/.acc-mcp/naming (vd [ma-du-an]) ====
ACC_MCP_NAMING_CONFIG=iso19650-uk

# ==== (Tuỳ chọn) Thư mục dữ liệu (token, downloads). Mặc định: ~/.acc-mcp ====
# ACC_MCP_DATA_DIR=

# ==== (Chỉ dùng khi bật lại chế độ 2-legged) Autodesk user id để impersonate ====
# ACC_USER_ID=
